<?xml version="1.0" encoding="utf-8"?>
<!-- Pantry tab: header, search, category filters and the RecyclerView of ingredients -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/my_pantry" />

        <ImageButton
            android:id="@+id/btn_add"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_green"
            android:contentDescription="@string/add_ingredient"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_add"
            android:tint="@color/white" />
    </LinearLayout>

    <EditText
        android:id="@+id/search_input"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:autofillHints=""
        android:background="@drawable/bg_field"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="10dp"
        android:drawableTint="@color/text_muted"
        android:hint="@string/search_ingredients"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="14sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/chip_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_all"
                style="@style/FilterChip"
                android:text="@string/filter_all" />

            <TextView
                android:id="@+id/chip_fresh"
                style="@style/FilterChip"
                android:tag="Fresh"
                android:text="@string/filter_fresh" />

            <TextView
                android:id="@+id/chip_dry"
                style="@style/FilterChip"
                android:tag="Dry"
                android:text="@string/filter_dry" />

            <TextView
                android:id="@+id/chip_dairy"
                style="@style/FilterChip"
                android:tag="Dairy"
                android:text="@string/filter_dairy" />

            <TextView
                android:id="@+id/chip_other"
                style="@style/FilterChip"
                android:tag="Other"
                android:text="@string/filter_other" />
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/pantry_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="12dp"
            tools:listitem="@layout/item_pantry" />

        <!-- Shown instead of the list when there is nothing to display -->
        <LinearLayout
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:background="@drawable/bg_circle_pale"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="@string/emoji_basket"
                android:textSize="52sp" />

            <TextView
                android:id="@+id/empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/pantry_empty_title"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/empty_body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/pantry_empty_body"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
