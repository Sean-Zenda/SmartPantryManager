<?xml version="1.0" encoding="utf-8"?>
<!-- Suggested Recipes tab -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp">

    <TextView
        style="@style/Text.Title"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:text="@string/suggested_recipes" />

    <!-- "You have N recipes you can make!" -->
    <TextView
        android:id="@+id/match_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_banner_pale"
        android:drawableStart="@drawable/ic_check_circle"
        android:drawablePadding="10dp"
        android:drawableTint="@color/green_primary"
        android:gravity="center_vertical"
        android:padding="14dp"
        android:textColor="@color/green_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="You have 8 recipes you can make!"
        tools:visibility="visible" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recipe_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="12dp"
            tools:listitem="@layout/item_recipe" />

        <!-- No recipe passes the strict rule and none is even one ingredient away -->
        <LinearLayout
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/bg_circle_pale"
                android:importantForAccessibility="no"
                android:padding="30dp"
                android:src="@drawable/ic_chef"
                android:tint="@color/green_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/no_match_title"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/no_match_body"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_go_to_pantry"
                style="@style/Widget.SmartPantry.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:paddingStart="36dp"
                android:paddingEnd="36dp"
                android:text="@string/go_to_pantry" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
