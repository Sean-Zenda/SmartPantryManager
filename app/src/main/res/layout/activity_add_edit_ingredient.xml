<?xml version="1.0" encoding="utf-8"?>
<!-- Add / Edit Ingredient form. The same layout serves both modes; the Activity switches the title
     and shows the Delete button only when editing. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/add_edit_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:orientation="vertical"
    tools:context=".AddEditIngredientActivity">

    <!-- top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="20dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            android:tint="@color/text_primary" />

        <TextView
            android:id="@+id/screen_title"
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="20sp"
            tools:text="@string/add_ingredient" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- live icon preview -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/icon_preview"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/bg_circle_pale"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:textSize="44sp"
                    tools:text="🍅" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="@string/icon_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- name -->
            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:labelFor="@id/name_input"
                android:text="@string/label_name" />

            <EditText
                android:id="@+id/name_input"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:autofillHints=""
                android:background="@drawable/bg_field"
                android:hint="@string/hint_name"
                android:imeOptions="actionNext"
                android:inputType="textCapSentences"
                android:maxLength="40"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/name_error"
                style="@style/Text.Error"
                tools:text="@string/err_name_short"
                tools:visibility="visible" />

            <!-- quantity + unit -->
            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:labelFor="@id/quantity_input"
                android:text="@string/label_quantity" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/quantity_input"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:autofillHints=""
                    android:background="@drawable/bg_field"
                    android:hint="@string/hint_quantity"
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal"
                    android:maxLength="9"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="15sp" />

                <FrameLayout
                    android:layout_width="120dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_field">

                    <Spinner
                        android:id="@+id/unit_spinner"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:contentDescription="@string/unit"
                        android:paddingEnd="28dp" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="10dp"
                        android:importantForAccessibility="no"
                        android:rotation="90"
                        android:src="@drawable/ic_chevron"
                        android:tint="@color/text_secondary" />
                </FrameLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/quantity_error"
                style="@style/Text.Error" />

            <!-- expiry date -->
            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/label_expiry" />

            <FrameLayout
                android:id="@+id/expiry_field"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_field">

                <TextView
                    android:id="@+id/expiry_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:drawableStart="@drawable/ic_calendar"
                    android:drawablePadding="12dp"
                    android:drawableTint="@color/text_secondary"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="48dp"
                    android:text="@string/hint_select_date"
                    android:textColor="@color/text_muted"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/btn_clear_date"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/clear_date"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_close"
                    android:tint="@color/text_secondary"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/expiry_error"
                style="@style/Text.Error" />

            <!-- category -->
            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/label_category" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/cat_fresh"
                    style="@style/FilterChip"
                    android:tag="Fresh"
                    android:text="@string/filter_fresh" />

                <TextView
                    android:id="@+id/cat_dry"
                    style="@style/FilterChip"
                    android:tag="Dry"
                    android:text="@string/filter_dry" />

                <TextView
                    android:id="@+id/cat_dairy"
                    style="@style/FilterChip"
                    android:tag="Dairy"
                    android:text="@string/filter_dairy" />

                <TextView
                    android:id="@+id/cat_other"
                    style="@style/FilterChip"
                    android:tag="Other"
                    android:text="@string/filter_other" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="32dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                style="@style/Widget.SmartPantry.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/save" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:text="@string/delete"
                android:textColor="@color/status_danger"
                android:textSize="16sp"
                android:visibility="gone"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_delete"
                app:iconGravity="textStart"
                app:iconTint="@color/status_danger"
                app:strokeColor="@color/status_danger"
                tools:visibility="visible" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
