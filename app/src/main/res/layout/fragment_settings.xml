<?xml version="1.0" encoding="utf-8"?>
<!-- Settings tab -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:text="@string/settings" />

        <!-- app identity card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_green"
                android:importantForAccessibility="no"
                android:padding="14dp"
                android:src="@drawable/ic_leaf"
                android:tint="@color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/app_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    tools:text="Version 1.0" />
            </LinearLayout>
        </LinearLayout>

        <!-- preferences -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/row_alerts"
                style="@style/SettingsRow">

                <ImageView
                    style="@style/SettingsRow.Icon"
                    android:src="@drawable/ic_bell" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsRow.Title"
                        android:text="@string/expiring_alerts" />

                    <TextView
                        style="@style/SettingsRow.Subtitle"
                        android:text="@string/expiring_alerts_sub" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_alerts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/expiring_alerts" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <LinearLayout
                android:id="@+id/row_units"
                style="@style/SettingsRow">

                <ImageView
                    style="@style/SettingsRow.Icon"
                    android:src="@drawable/ic_scale" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsRow.Title"
                        android:text="@string/units_pref" />

                    <TextView
                        android:id="@+id/units_subtitle"
                        style="@style/SettingsRow.Subtitle"
                        tools:text="@string/units_metric" />
                </LinearLayout>

                <ImageView style="@style/SettingsRow.Chevron" />
            </LinearLayout>
        </LinearLayout>

        <!-- information -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/row_about"
                style="@style/SettingsRow">

                <ImageView
                    style="@style/SettingsRow.Icon"
                    android:src="@drawable/ic_info" />

                <TextView
                    style="@style/SettingsRow.Title"
                    android:layout_width="0dp"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="@string/about_app" />

                <ImageView style="@style/SettingsRow.Chevron" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <LinearLayout
                android:id="@+id/row_help"
                style="@style/SettingsRow">

                <ImageView
                    style="@style/SettingsRow.Icon"
                    android:src="@drawable/ic_help" />

                <TextView
                    style="@style/SettingsRow.Title"
                    android:layout_width="0dp"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="@string/help_support" />

                <ImageView style="@style/SettingsRow.Chevron" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="@string/settings_footer"
            android:textColor="@color/green_primary"
            android:textSize="18sp"
            android:textStyle="italic" />
    </LinearLayout>
</ScrollView>
