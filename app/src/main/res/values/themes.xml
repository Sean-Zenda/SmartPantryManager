<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.SmartPantry" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorOnPrimary">@color/text_on_green</item>
        <item name="colorSecondary">@color/green_mid</item>
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:statusBarColor">@color/cream</item>
        <item name="android:navigationBarColor">@color/surface_white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Theme.SmartPantry" parent="Base.Theme.SmartPantry" />

    <!-- Dark green primary button used across the app -->
    <style name="Widget.SmartPantry.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="backgroundTint">@color/green_primary</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">54dp</item>
    </style>

    <style name="Text.Label" parent="">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <style name="Text.Title" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
